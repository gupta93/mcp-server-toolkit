# Logging
MCP_TOOLKIT_LOG_LEVEL=INFO
MCP_TOOLKIT_LOG_JSON=false

# Optional GitHub token (raises rate limits; public repos work without it)
# MCP_TOOLKIT_GITHUB_TOKEN=

# Read-only SQL database (SQLite file path or Postgres URL)
MCP_TOOLKIT_DATABASE_URL=sqlite:///demo_data/demo.db

# Streamable HTTP transport defaults
MCP_TOOLKIT_HTTP_HOST=127.0.0.1
MCP_TOOLKIT_HTTP_PORT=8000
MCP_TOOLKIT_HTTP_PATH=/mcp

# Query guardrails
MCP_TOOLKIT_MAX_SQL_ROWS=100
MCP_TOOLKIT_HTTP_TIMEOUT=30
