# Logging
MCP_TOOLKIT_LOG_LEVEL=INFO
MCP_TOOLKIT_LOG_JSON=false

# Optional GitHub token (raises rate limits; public repos work without it)
# MCP_TOOLKIT_GITHUB_TOKEN=

# Demo SQLite database directory (seed copied from package data at startup)
MCP_TOOLKIT_DATA_DIR=~/.local/share/mcp-server-toolkit
MCP_TOOLKIT_DATABASE_URL=sqlite:///demo.db

# OpenAPI outbound HTTP (required before call_openapi_operation can reach the network)
# MCP_TOOLKIT_OPENAPI_ALLOWED_HOSTS=httpbin.org,api.example.com
MCP_TOOLKIT_OPENAPI_MAX_RESPONSE_BYTES=262144

# Streamable HTTP transport defaults
MCP_TOOLKIT_HTTP_HOST=127.0.0.1
MCP_TOOLKIT_HTTP_PORT=8000
MCP_TOOLKIT_HTTP_PATH=/mcp

# Query guardrails
MCP_TOOLKIT_MAX_SQL_ROWS=100
MCP_TOOLKIT_POSTGRES_STATEMENT_TIMEOUT_MS=5000
MCP_TOOLKIT_HTTP_TIMEOUT=30
